	"info": {
		"info_bandits": {
			"title": "Banditi a nord",
			"text": "Jed Harlan e la sua banda battono le strade a nord della città. Meglio non viaggiare da soli."
		},
		"info_wanted_board": {
			"title": "Bacheca dei ricercati",
			"text": "Lo sceriffo tiene d'occhio tre fuorilegge: Jed Harlan, Maria la Volpe e Silas Crow."
		},
		"info_silas": {
			"title": "Silas Crow",
			"text": "Silas Crow è il più pericoloso: lo hanno visto vicino alla vecchia miniera, ma si sposta di notte."
		},
		"info_rumor_mine": {
			"title": "Voce sulla miniera",
			"text": "Al saloon si dice che qualcuno abbia trovato una vena d'argento nella miniera abbandonata."
		},
		"info_bank_hours": {
			"title": "Orari della banca",
			"text": "La banca apre dalle 9 alle 17. Fuori orario le porte restano sbarrate."
		},
		"info_loans": {
			"title": "Prestiti in banca",
			"text": "La banca fa credito in base alla reputazione tra i commercianti e al deposito in cassa. Il tasso segue il mercato. Chi non paga perde il conto e il credito."
		},
		"info_robbery_risk": {
			"title": "Timore di rapina",
			"text": "Il banchiere teme una rapina: i trasporti di contante arrivano di giovedì."
		},
		"info_secret_saloon": {
			"title": "Il segreto del saloon",
			"text": "Il barista nasconde casse di whiskey di contrabbando nella cantina del saloon."
		},
		"info_mine": {
			"title": "Miniera pericolosa",
			"text": "La miniera a ovest è instabile: due uomini sono rimasti feriti la settimana scorsa."
		},
		"info_silver": {
			"title": "Galleria sigillata",
			"text": "Una galleria sigillata nella miniera potrebbe contenere argento. Il caposquadra non vuole che se ne parli."
		},
		"info_hunting": {
			"title": "Caccia al fiume",
			"text": "I cervi scendono al fiume all'alba. Il tramonto è l'ora dei coyote."
		},
		"info_market": {
			"title": "Prezzi in città",
			"text": "I prezzi cambiano con le stagioni e con le carovane in arrivo."
		},
		"info_mercenary": {
			"title": "Tariffe dei mercenari",
			"text": "I mercenari chiedono circa cento dollari al giorno e non fanno domande."
		},
		"info_gang_hint": {
			"title": "I Corvi",
			"text": "Una banda chiamata i Corvi controlla le strade a est. Pagano bene chi tace."
		}
